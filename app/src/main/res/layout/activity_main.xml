<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FFmpeg RTSP Player"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_single_player"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="单流播放器"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_multi_player"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="多流播放器"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_yuv_test"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="YUV 数据测试"
        android:textSize="18sp"
        android:backgroundTint="#9C27B0"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_headless_analysis"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Headless 分析模式"
        android:textSize="18sp"
        android:backgroundTint="#009688"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_transform_test"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="画面变换测试"
        android:textSize="18sp"
        android:backgroundTint="#FF9800" />

</LinearLayout>
