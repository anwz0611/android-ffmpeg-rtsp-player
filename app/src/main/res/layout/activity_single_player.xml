<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/sourceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="视频源"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="输入 RTSP 地址后即可预览。"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="RTSP 地址"
                app:boxBackgroundMode="outline"
                app:helperText="示例：rtsp://192.168.1.10:554/live"
                app:startIconDrawable="@android:drawable/ic_menu_share">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_rtsp_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="RTSP 地址"
                    android:inputType="textUri"
                    android:text="rtsp://stream.strba.sk:1935/strba/VYHLAD_JAZERO.stream" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/previewSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="实时预览"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_preview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="视频画面与状态会同时显示，便于快速确认连接是否正常。"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/previewSurfaceContainer"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/video_panel_bg">

                <SurfaceView
                    android:id="@+id/surface_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/status_badge_bg"
                    android:text="等待预览"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="开始预览" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="停止预览" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_record"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="录制" />

                <Button
                    android:id="@+id/btn_destroy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="重置连接" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_toggle_orientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="进入横屏" />

            <TextView
                android:id="@+id/tv_live_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="首帧、在线时长、分辨率和解码方式会在播放后显示。"
                android:textColor="@color/text_body"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/configSectionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/configSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="高级设置"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="默认值通常就够用，需要时再展开。"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/configSectionToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="展开"
                    android:textColor="@color/text_body"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/configSectionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="常用选项"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="这些是最常改的项，优先从这里调整。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_software_decode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="软解码"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="关闭时优先使用硬解码。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_audio_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="启用音频"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="关闭后只播放视频，不会初始化音频输出。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_fast_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="启用 Fast Seek"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="优化定位和追帧速度，直播场景通常保持开启。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="缓冲区大小"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：字节。默认 4096，网络抖动大时可适当调高。"
                    app:suffixText="B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_buffer_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="缓冲区大小"
                        android:inputType="number"
                        android:text="4096" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="超时时间"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：毫秒。连接或读流超时时间，默认 10000。"
                    app:suffixText="ms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_timeout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="超时时间"
                        android:inputType="number"
                        android:text="10000" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="初始音频缓冲"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：毫秒。范围 20-1000，数值越大越稳，越小越跟手。"
                    app:suffixText="ms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_audio_init_buffer_ms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="初始音频缓冲"
                        android:inputType="number"
                        android:text="200" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#EAECF0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="渲染与延迟"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="这一组决定拉流稳定性、显示方式和实时性。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="RTSP 传输协议"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="自动模式兼容性最好；TCP 更稳，UDP 延迟更低，组播只在明确使用组播源时选择。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_transport_protocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkedButton="@id/rb_transport_auto"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_transport_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动选择" />

                    <RadioButton
                        android:id="@+id/rb_transport_tcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TCP：更稳定，丢包少" />

                    <RadioButton
                        android:id="@+id/rb_transport_udp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UDP：更低延迟" />

                    <RadioButton
                        android:id="@+id/rb_transport_multicast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="组播：仅限组播源" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_rtsp_keep_alive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="启用 RTSP Keep-Alive"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="长期在线的设备流建议保持开启，防止服务端因空闲而断开会话。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Keep-Alive 间隔"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：秒。RTSP 会话保活间隔，默认 30 秒。"
                    app:suffixText="s">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_rtsp_keep_alive_interval"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Keep-Alive 间隔"
                        android:inputType="number"
                        android:text="30" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="代理设置"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="需要经过 HTTP / SOCKS 代理访问视频源时再填写；留空时直连。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="代理地址"
                    app:boxBackgroundMode="outline"
                    app:helperText="示例：http://127.0.0.1:7890">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_proxy_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="代理地址"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="代理用户名"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_proxy_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="代理用户名"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="代理密码"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_proxy_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="代理密码"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="渲染模式"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="硬解有 3 种渲染方式，软解有 2 种。切换软解开关时，会显示对应可选项。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_renderer_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkedButton="@id/rb_renderer_hw_surface_direct"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_renderer_hw_surface_direct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="硬解 / SURFACE_DIRECT：直出 Surface，开销最低" />

                    <RadioButton
                        android:id="@+id/rb_renderer_hw_opengl_texture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="硬解 / OPENGL_TEXTURE：纹理渲染，适合低延迟预览" />

                    <RadioButton
                        android:id="@+id/rb_renderer_hw_cpu_frame_opengl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="硬解 / CPU_FRAME_OPENGL：CPU 帧转 OpenGL，偏兼容调试" />

                    <RadioButton
                        android:id="@+id/rb_renderer_sw_opengl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="软解 / OPENGL：软解后走 OpenGL 渲染"
                        android:visibility="gone" />

                    <RadioButton
                        android:id="@+id/rb_renderer_sw_surface"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="软解 / SURFACE：软解后走软件渲染输出"
                        android:visibility="gone" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="延迟模式"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="均衡模式更稳；超低延迟模式更适合实时预览和对讲类场景。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_latency_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkedButton="@id/rb_latency_ultra_low"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_latency_balanced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="均衡：稳定优先" />

                    <RadioButton
                        android:id="@+id/rb_latency_ultra_low"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="超低延迟：时效优先" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="主时钟策略"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="一般保持自动。音频主时钟适合重视声音连续性；视频主时钟适合更看重画面节奏。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rg_clock_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checkedButton="@id/rb_clock_auto"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_clock_auto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动" />

                    <RadioButton
                        android:id="@+id/rb_clock_audio_master"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="音频主时钟" />

                    <RadioButton
                        android:id="@+id/rb_clock_video_master"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="视频主时钟" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#EAECF0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="恢复策略"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="断流、无包或连接失败时，按这一组参数决定是否自动恢复以及恢复频率。"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_recovery_enabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="断流自动恢复"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="网络中断、无包或连接失败时按下面的恢复策略自动重连。"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="最大恢复次数"
                    app:boxBackgroundMode="outline"
                    app:helperText="断流后最多重试多少次。默认 3 次。"
                    app:suffixText="次">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_recovery_max_attempts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="最大恢复次数"
                        android:inputType="number"
                        android:text="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="恢复间隔"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：毫秒。两次重试之间等待多久。"
                    app:suffixText="ms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_recovery_interval_ms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="恢复间隔"
                        android:inputType="number"
                        android:text="300" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="无包超时"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：毫秒。超过这个时间没收到数据包，就判定需要恢复。"
                    app:suffixText="ms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_recovery_no_packet_timeout_ms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="无包超时"
                        android:inputType="number"
                        android:text="1500" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="连接超时"
                    app:boxBackgroundMode="outline"
                    app:helperText="单位：毫秒。单次重连在多长时间内必须建立连接。"
                    app:suffixText="ms">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_recovery_connect_timeout_ms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="连接超时"
                        android:inputType="number"
                        android:text="3000" />
                </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusInfoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_panel_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="连接状态"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_stream_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="流信息: 无"
                android:textColor="@color/text_body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_record_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="录制状态: 未录制"
                android:textColor="@color/text_body"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/performanceMonitorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/performanceMonitorHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="诊断详情"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/performanceMonitorToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textColor="@color/text_body"
                        android:textSize="14sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/performanceMonitorContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="400dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/performanceMonitorTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:padding="8dp"
                        android:text="诊断数据..."
                        android:textColor="@color/text_body"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
