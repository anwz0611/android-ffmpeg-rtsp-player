<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部输入栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#f0f0f0">

            <EditText
                android:id="@+id/et_rtsp_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入RTSP地址"
                android:text="rtsp://stream.strba.sk:1935/strba/VYHLAD_JAZERO.stream"
                android:padding="8dp" />

        </LinearLayout>

        <!-- 视频显示区域 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/surface_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="待播放"
                android:textColor="#ffffff"
                android:textSize="16sp" />

        </FrameLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#f0f0f0">

        <Button
            android:id="@+id/btn_play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="播放"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="停止"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_record"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="录制"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- 状态信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#e0e0e0">

        <TextView
            android:id="@+id/tv_stream_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="流信息: 无"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_record_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="录制状态: 未录制"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 性能监控面板（可展开/折叠） -->
    <androidx.cardview.widget.CardView
        android:id="@+id/performanceMonitorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 标题栏（可点击展开/折叠） -->
            <LinearLayout
                android:id="@+id/performanceMonitorHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 性能监控"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/performanceMonitorToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 监控内容（可展开/折叠） -->
            <ScrollView
                android:id="@+id/performanceMonitorContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="400dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/performanceMonitorTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="性能监控数据..."
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="8dp" />

            </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
